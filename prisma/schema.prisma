generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  fullName        String
  matricNumber    String               @unique
  level           String
  department      String
  profilePicture  String?
  isAdmin         Boolean              @default(false)
  isBanned        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  acknowledgments Acknowledgment[]
  signatures      AgreementSignature[]
  comments        Comment[]
  convAsA         Conversation[]       @relation("ConvParticipantA")
  convAsB         Conversation[]       @relation("ConvParticipantB")
  messagesSent    Message[]
  ordersAsBuyer   Order[]              @relation("BuyerOrders")
  ordersAsSeller  Order[]              @relation("SellerOrders")
  products        Product[]
  reportsAgainst  Report[]             @relation("ReportedReports")
  reportsMade     Report[]             @relation("ReporterReports")
  reviews         Review[]
  storefront      Storefront?
}

model Storefront {
  id            String    @id @default(cuid())
  ownerId       String    @unique
  name          String
  description   String
  type          String
  bankName      String
  bankCode      String?
  accountName   String
  accountNumber String
  phoneNumber   String
  contactEmail  String
  recipientCode String?
  status        String    @default("active")
  rating        Float     @default(0)
  totalSales    Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]   @relation("StorefrontOrders")
  products      Product[]
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Agreement {
  id                   String               @id @default(cuid())
  version              String               @unique
  title                String
  body                 String
  serviceChargePercent Float                @default(20)
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  signatures           AgreementSignature[]
}

model AgreementSignature {
  id          String    @id @default(cuid())
  agreementId String
  userId      String
  signedAt    DateTime  @default(now())
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agreementId, userId])
}

model Category {
  id               String    @id @default(cuid())
  name             String    @unique
  slug             String    @unique
  description      String?
  icon             String?
  origin           String    @default("default")
  requiresApproval Boolean   @default(false)
  createdAt        DateTime  @default(now())
  products         Product[]
}

model Product {
  id              String         @id @default(cuid())
  title           String
  description     String
  price           Float
  kind            String         @default("product")
  condition       String?
  stock           Int            @default(1)
  categoryId      String
  subcategorySlug String?
  sellerId        String
  storefrontId    String
  status          String         @default("active")
  rating          Float          @default(0)
  reviewCount     Int            @default(0)
  views           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  comments        Comment[]
  orders          Order[]
  category        Category       @relation(fields: [categoryId], references: [id])
  seller          User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  storefront      Storefront     @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  media           ProductMedia[]
  reviews         Review[]
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  type      String
  url       String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                String           @id @default(cuid())
  reference         String           @unique
  productId         String
  storefrontId      String
  buyerId           String
  sellerId          String
  quantity          Int              @default(1)
  unitPrice         Float
  totalAmount       Float
  serviceCharge     Float
  sellerPayout      Float
  status            String           @default("pending")
  paystackReference String?          @unique
  paidAt            DateTime?
  payoutStatus      String           @default("not_started")
  transferReference String?
  payoutAt          DateTime?
  acknowledged      Boolean          @default(false)
  acknowledgedAt    DateTime?
  refundRequested   Boolean          @default(false)
  refundReason      String?
  refundedAt        DateTime?
  deliveryAddress   String?
  deliveryNotes     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  acknowledgments   Acknowledgment[]
  buyer             User             @relation("BuyerOrders", fields: [buyerId], references: [id])
  product           Product          @relation(fields: [productId], references: [id])
  seller            User             @relation("SellerOrders", fields: [sellerId], references: [id])
  storefront        Storefront       @relation("StorefrontOrders", fields: [storefrontId], references: [id])
}

model Acknowledgment {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  type      String
  note      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  productId String
  userId    String
  body      String
  parentId  String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String
  productId      String?
  reason         String
  details        String
  status         String   @default("open")
  adminNote      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reportedUser   User     @relation("ReportedReports", fields: [reportedUserId], references: [id])
  reporter       User     @relation("ReporterReports", fields: [reporterId], references: [id])
}

model Conversation {
  id             String    @id @default(cuid())
  type           String    @default("direct")
  participantAId String
  participantBId String?
  subject        String?
  createdAt      DateTime  @default(now())
  participantA   User      @relation("ConvParticipantA", fields: [participantAId], references: [id])
  participantB   User?     @relation("ConvParticipantB", fields: [participantBId], references: [id])
  messages       Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  adminSeen      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
}
