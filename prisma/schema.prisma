// ABUAD Marketplace — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  matricNumber    String   @unique
  level           String   // e.g. "100", "200", "300", "400", "500"
  department      String
  profilePicture  String?  // URL or base64 data URL
  isAdmin         Boolean  @default(false)
  isBanned        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  storefront      Storefront?
  products        Product[]
  ordersAsBuyer   Order[]      @relation("BuyerOrders")
  ordersAsSeller  Order[]      @relation("SellerOrders")
  reviews         Review[]
  comments        Comment[]
  reportsMade     Report[]     @relation("ReporterReports")
  reportsAgainst  Report[]     @relation("ReportedReports")
  messagesSent    Message[]
  signatures      AgreementSignature[]
  acknowledgments Acknowledgment[]
  convAsA         Conversation[] @relation("ConvParticipantA")
  convAsB         Conversation[] @relation("ConvParticipantB")
}

model Storefront {
  id              String   @id @default(cuid())
  ownerId         String   @unique
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  description     String
  // Service / product types they offer
  type            String   // "products" | "services" | "both"
  // Payout details
  bankName        String
  bankCode        String?  // Paystack bank code, resolved server-side, needed to pay out
  accountName     String
  accountNumber   String
  phoneNumber     String
  contactEmail    String
  recipientCode   String?  // Paystack transfer recipient code (created once, reused)
  // Food category needs admin approval
  status          String   @default("active") // "active" | "pending_approval" | "suspended" | "rejected"
  rating          Float    @default(0)
  totalSales      Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products        Product[]
  orders          Order[]      @relation("StorefrontOrders")
}

model Agreement {
  id              String   @id @default(cuid())
  version         String   @unique // e.g. "1.0"
  title           String
  body            String   // full legal text (markdown / plain)
  serviceChargePercent Float @default(20)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  signatures      AgreementSignature[]
}

model AgreementSignature {
  id              String   @id @default(cuid())
  agreementId     String
  agreement       Agreement @relation(fields: [agreementId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signedAt        DateTime @default(now())

  @@unique([agreementId, userId])
}

model Category {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  icon            String?
  // "default" = built-in; "auto" = generated by algorithm; "custom" = admin created
  origin          String   @default("default")
  // Food category requires admin approval per storefront
  requiresApproval Boolean @default(false)
  createdAt       DateTime @default(now())

  products        Product[]
}

model Product {
  id              String   @id @default(cuid())
  title           String
  description     String
  price           Float
  // "product" | "service"
  kind            String   @default("product")
  condition       String?  // for products: "new" | "fairly_used" | "used"
  stock           Int      @default(1)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  subcategorySlug String?
  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  storefrontId    String
  storefront      Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  // Status: "active" | "out_of_stock" | "paused" | "removed"
  status          String   @default("active")
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  media           ProductMedia[]
  orders          Order[]
  reviews         Review[]
  comments        Comment[]
}

model ProductMedia {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // "image" | "video" | "audio"
  type            String
  url             String   // data URL or external URL
  createdAt       DateTime @default(now())
}

model Order {
  id              String   @id @default(cuid())
  reference       String   @unique // human-friendly order number
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  storefrontId    String
  storefront      Storefront @relation("StorefrontOrders", fields: [storefrontId], references: [id])
  buyerId         String
  buyer           User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId        String
  seller          User     @relation("SellerOrders", fields: [sellerId], references: [id])
  quantity        Int      @default(1)
  unitPrice       Float
  totalAmount     Float
  serviceCharge   Float    // 20% of net profit
  sellerPayout    Float    // amount to be paid to seller after charge
  // "pending" | "paid" | "in_transit" | "delivered" | "acknowledged" | "disputed" | "refunded" | "completed"
  status          String   @default("pending")
  // Payment collection (buyer -> platform escrow account)
  paystackReference String?  @unique // reference used on the Paystack transaction
  paidAt          DateTime?
  // Payout (platform escrow account -> seller), released after acknowledgment
  payoutStatus    String   @default("not_started") // "not_started" | "processing" | "success" | "failed"
  transferReference String?
  payoutAt        DateTime?
  // Buyer acknowledges receipt -> triggers payout
  acknowledged    Boolean  @default(false)
  acknowledgedAt  DateTime?
  // Refund flow
  refundRequested Boolean  @default(false)
  refundReason    String?
  refundedAt      DateTime?
  deliveryAddress String?
  deliveryNotes   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  acknowledgments Acknowledgment[]
}

model Acknowledgment {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  // "received" | "disputed"
  type            String
  note            String?
  createdAt       DateTime @default(now())
}

model Review {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  rating          Int      // 1-5
  comment         String
  createdAt       DateTime @default(now())

  @@unique([productId, userId])
}

model Comment {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  body            String
  parentId        String?  // for threaded replies
  createdAt       DateTime @default(now())
}

model Report {
  id              String   @id @default(cuid())
  reporterId      String
  reporter        User     @relation("ReporterReports", fields: [reporterId], references: [id])
  reportedUserId  String
  reportedUser    User     @relation("ReportedReports", fields: [reportedUserId], references: [id])
  productId       String?
  reason          String
  details         String
  // "open" | "reviewing" | "resolved" | "dismissed"
  status          String   @default("open")
  adminNote       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Conversation {
  id              String   @id @default(cuid())
  // For 1:1 between users; "broadcast" if admin pushes to everyone
  type            String   @default("direct") // "direct" | "admin_direct" | "broadcast"
  participantAId  String
  participantA    User     @relation("ConvParticipantA", fields: [participantAId], references: [id])
  participantBId  String?
  participantB    User?    @relation("ConvParticipantB", fields: [participantBId], references: [id])
  subject         String?
  createdAt       DateTime @default(now())

  messages        Message[]
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id])
  body            String
  // Admin can see all; flag indicates admin has read
  adminSeen       Boolean  @default(false)
  createdAt       DateTime @default(now())
}
