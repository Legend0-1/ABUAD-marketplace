// UNI MART — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String?  // WhatsApp number, used for order-alert contact — required for new signups via the API, nullable in the DB so this doesn't break migration for existing users
  passwordHash    String
  fullName        String
  matricNumber    String   @unique
  referralCode    String?  @unique // generated at account creation; backfilled for existing users on next app start
  referredById    String?
  referredBy      User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]   @relation("Referrals")
  level           String   // e.g. "100", "200", "300", "400", "500"
  department      String
  profilePicture  String?  // URL or base64 data URL
  isAdmin         Boolean  @default(false)
  isHR            Boolean  @default(false) // scoped admin role: manages delivery partner queue & assignments
  isBanned        Boolean  @default(false)
  // Two-factor authentication (TOTP)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  emailVerified   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  storefront      Storefront?
  products        Product[]
  ordersAsBuyer   Order[]      @relation("BuyerOrders")
  ordersAsSeller  Order[]      @relation("SellerOrders")
  reviews         Review[]
  comments        Comment[]
  reportsMade     Report[]     @relation("ReporterReports")
  reportsAgainst  Report[]     @relation("ReportedReports")
  messagesSent    Message[]
  signatures      AgreementSignature[]
  acknowledgments Acknowledgment[]
  convAsA         Conversation[] @relation("ConvParticipantA")
  convAsB         Conversation[] @relation("ConvParticipantB")
  feedback        Feedback[]
  auditLogs       AuditLog[]
  deliveryPartnerProfile DeliveryPartnerProfile?
  deliveryRequestsAsCustomer DeliveryRequest[] @relation("DeliveryCustomer")
  deliveryMessagesSent DeliveryMessage[]
  referralCommissionsEarned ReferralCommission[] @relation("ReferralEarnings")
  referralCommissionsGenerated ReferralCommission[] @relation("ReferralSpending")
}

model Storefront {
  id              String   @id @default(cuid())
  ownerId         String   @unique
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  description     String
  // Service / product types they offer
  type            String   // "products" | "services" | "both"
  // Payout details
  bankName        String
  bankCode        String?  // Paystack bank code, resolved server-side, needed to pay out
  accountName     String
  accountNumber   String
  phoneNumber     String
  contactEmail    String
  recipientCode   String?  // Paystack transfer recipient code (created once, reused)
  // Food category needs admin approval
  status          String   @default("active") // "active" | "pending_approval" | "suspended" | "rejected"
  rating          Float    @default(0)
  totalSales      Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products        Product[]
  orders          Order[]      @relation("StorefrontOrders")
}

model Agreement {
  id              String   @id @default(cuid())
  version         String   @unique // e.g. "1.0"
  title           String
  body            String   // full legal text (markdown / plain)
  serviceChargePercent Float @default(20)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  signatures      AgreementSignature[]
}

model AgreementSignature {
  id              String   @id @default(cuid())
  agreementId     String
  agreement       Agreement @relation(fields: [agreementId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signedAt        DateTime @default(now())

  @@unique([agreementId, userId])
}

model Category {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  icon            String?
  // "default" = built-in; "auto" = generated by algorithm; "custom" = admin created
  origin          String   @default("default")
  // Food category requires admin approval per storefront
  requiresApproval Boolean @default(false)
  createdAt       DateTime @default(now())

  products        Product[]
}

model Product {
  id              String   @id @default(cuid())
  title           String
  description     String
  price           Float
  // "product" | "service"
  kind            String   @default("product")
  condition       String?  // for products: "new" | "fairly_used" | "used"
  stock           Int      @default(1)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  subcategorySlug String?
  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  storefrontId    String
  storefront      Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  // Status: "active" | "out_of_stock" | "paused" | "removed"
  status          String   @default("active")
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  media           ProductMedia[]
  orders          Order[]
  reviews         Review[]
  comments        Comment[]
}

model ProductMedia {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // "image" | "video" | "audio"
  type            String
  url             String   // data URL or external URL
  createdAt       DateTime @default(now())
}

model Order {
  id              String   @id @default(cuid())
  reference       String   @unique // human-friendly order number
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  storefrontId    String
  storefront      Storefront @relation("StorefrontOrders", fields: [storefrontId], references: [id])
  buyerId         String
  buyer           User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId        String
  seller          User     @relation("SellerOrders", fields: [sellerId], references: [id])
  quantity        Int      @default(1)
  unitPrice       Float
  totalAmount     Float
  serviceCharge   Float    // 20% of net profit
  sellerPayout    Float    // amount to be paid to seller after charge
  // "pending" | "paid" | "in_transit" | "delivered" | "acknowledged" | "disputed" | "refunded" | "completed"
  status          String   @default("pending")
  // Payment collection (buyer -> platform escrow account)
  paystackReference String?  @unique // reference used on the Paystack transaction
  paidAt          DateTime?
  // Payout (platform escrow account -> seller), released after acknowledgment
  payoutStatus    String   @default("not_started") // "not_started" | "processing" | "success" | "failed"
  transferReference String?
  payoutAt        DateTime?
  // Buyer acknowledges receipt -> triggers payout
  acknowledged    Boolean  @default(false)
  acknowledgedAt  DateTime?
  // Refund flow
  refundRequested Boolean  @default(false)
  refundReason    String?
  refundedAt      DateTime?
  deliveryAddress String?
  deliveryNotes   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  acknowledgments Acknowledgment[]
}

model Acknowledgment {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  // "received" | "disputed"
  type            String
  note            String?
  createdAt       DateTime @default(now())
}

model Review {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  rating          Int      // 1-5
  comment         String
  createdAt       DateTime @default(now())

  @@unique([productId, userId])
}

model Comment {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  body            String
  parentId        String?  // for threaded replies
  createdAt       DateTime @default(now())
}

model Report {
  id              String   @id @default(cuid())
  reporterId      String
  reporter        User     @relation("ReporterReports", fields: [reporterId], references: [id])
  reportedUserId  String
  reportedUser    User     @relation("ReportedReports", fields: [reportedUserId], references: [id])
  productId       String?
  reason          String
  details         String
  // "open" | "reviewing" | "resolved" | "dismissed"
  status          String   @default("open")
  adminNote       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Conversation {
  id              String   @id @default(cuid())
  // For 1:1 between users; "broadcast" if admin pushes to everyone
  type            String   @default("direct") // "direct" | "admin_direct" | "broadcast"
  participantAId  String
  participantA    User     @relation("ConvParticipantA", fields: [participantAId], references: [id])
  participantBId  String?
  participantB    User?    @relation("ConvParticipantB", fields: [participantBId], references: [id])
  subject         String?
  createdAt       DateTime @default(now())

  messages        Message[]
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id])
  body            String
  // Admin can see all; flag indicates admin has read
  adminSeen       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// Records key platform actions for admin accountability & troubleshooting.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel  String   // denormalized name/role snapshot, survives actor deletion
  action      String   // e.g. "order.refund", "storefront.approve", "user.ban", "agreement.update"
  targetType  String?  // e.g. "Order", "Storefront", "User"
  targetId    String?
  detail      String?  // short human-readable summary, no sensitive payloads
  createdAt   DateTime @default(now())
}

// "Give opinion on how to make the platform better" — general suggestions/feedback.
model Feedback {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String   // "suggestion" | "bug" | "compliment" | "other"
  message     String
  status      String   @default("new") // "new" | "reviewed" | "actioned" | "archived"
  createdAt   DateTime @default(now())
}

// --- Delivery Partner + HR dispatch system ---
//
// Two job types with different payout timing:
//   buy_and_deliver: partner fronts money to purchase an item for the customer.
//     itemCost is released to the partner immediately on confirmed availability
//     (before delivery) -- an intentional exception to the platform's usual
//     escrow-until-acknowledgment rule, since the partner needs capital to buy
//     the item. serviceFee still waits for customer confirmation like normal.
//   errand_only: no purchase, no customer<->partner contact at all (per spec).
//     Full serviceFee is held until the customer confirms completion.
model DeliveryPartnerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("pending_review") // pending_review | approved | rejected | suspended
  videoUrl        String   // KYC video (data URL, same upload pattern as product media)
  bankName        String
  bankCode        String?
  accountName     String
  accountNumber   String
  recipientCode   String?  // Paystack transfer recipient, created on first payout
  baseFeeNote     String?  // partner's stated pricing/availability notes
  trustScore      Int      @default(0)
  // Separate, explicitly-granted gate for buy_and_deliver jobs -- general
  // approval alone only qualifies a partner for errand_only work. HR must
  // review the KYC video and track record before flipping this on.
  typeAEligible   Boolean  @default(false)
  typeAApprovedById String?
  typeAApprovedAt DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  requests        DeliveryRequest[]
}

model DeliveryRequest {
  id              String   @id @default(cuid())
  reference       String   @unique
  customerId      String
  customer        User     @relation("DeliveryCustomer", fields: [customerId], references: [id])
  type            String   // "buy_and_deliver" | "errand_only"
  description     String
  dropoffLocation String
  itemCost        Float?   // null for errand_only
  serviceFee      Float
  totalPaid       Float
  status          String   @default("pending_payment")
  // pending_payment -> pending_hr (paid, awaiting HR assignment) -> awaiting_partner (assigned, awaiting accept/decline)
  // -> in_progress -> completed | disputed | cancelled
  // (buy_and_deliver additionally tracks itemCostReleasedAt mid-flow, once partner accepts)

  paystackReference String? @unique
  paidAt          DateTime?

  partnerId       String?
  partner         DeliveryPartnerProfile? @relation(fields: [partnerId], references: [id])
  assignedById    String?  // HR user who made the assignment
  itemCostReleasedAt DateTime?
  itemCostTransferRef String?
  serviceFeeReleasedAt DateTime?
  serviceFeeTransferRef String?
  customerConfirmedAt DateTime?

  createdAt       DateTime @default(now())

  messages        DeliveryMessage[]
}

model DeliveryMessage {
  // buy_and_deliver only -- errand_only has zero customer<->partner contact per spec
  id              String   @id @default(cuid())
  requestId       String
  request         DeliveryRequest @relation(fields: [requestId], references: [id])
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id])
  body            String
  createdAt       DateTime @default(now())
}

// Every 5 qualifying (completed) purchases by a referred user triggers a
// commission batch: 5% of the combined total of those 5 orders, credited to
// the referrer. Paid out manually by admin for now (referrers-only accounts
// don't have bank details on file the way sellers/delivery partners do) --
// see AdminReferralManager for the "mark as paid" flow.
model ReferralCommission {
  id                String   @id @default(cuid())
  referrerId        String
  referrer          User     @relation("ReferralEarnings", fields: [referrerId], references: [id])
  referredUserId    String
  referredUser      User     @relation("ReferralSpending", fields: [referredUserId], references: [id])
  qualifyingOrderIds String  // JSON array of the 5 order IDs this batch covers
  batchTotal        Float    // combined value of the 5 qualifying orders
  commissionAmount  Float    // 5% of batchTotal
  status            String   @default("pending") // pending | paid | cancelled
  paidAt            DateTime?
  paidById          String?
  createdAt         DateTime @default(now())
}
